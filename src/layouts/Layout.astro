---
// This script block keeps Astro happy when reading Markdown frontmatter
const { frontmatter } = Astro.props;
---
<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		
		<title>{frontmatter.title}</title>
		
		<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" crossorigin="" />
		<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" crossorigin=""></script>
	</head>
	<body>
		<nav style="padding: 1rem 2rem; background: #13151a; border-bottom: 1px solid #23262d;">
			<a href="/" style="color: #dae5ff; text-decoration: none; font-weight: 500;">&larr; Back to Home</a>
		</nav>

		<main style="max-width: 800px; margin: 0 auto; padding: 2rem 1rem; color: #fff;">
			<slot />
		</main>
	</body>
</html>

<style is:global>
	html,
	body {
		margin: 0;
		padding: 0;
		width: 100%;
		height: 100%;
		background-color: #13151a;
		font-family: system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, sans-serif;
	}
	
	/* Smooth link colors inside your markdown text */
	a {
		color: #4f46e5;
	}
</style>