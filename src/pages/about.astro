---
// src/pages/about.astro
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>numogram // about</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Archivo:ital,wght=0,500;0,700;0,900;1,900&display=swap" rel="stylesheet">
    <script is:inline>
      const savedTheme = localStorage.getItem('schema-theme') || 'dark';
      document.documentElement.setAttribute('data-theme', savedTheme);
    </script>
  </head>
  <body>

    <div class="monograph-frame">
      
      <header class="schema-header">
        <div class="meta-left">t.thatcher // core_biography</div>
        <div class="meta-right">plate_3.01 // systemic_overview</div>
      </header>

      <main class="diagram-matrix">
        
        <section class="dossier-left">
          <div class="sticky-manifesto">
            
            <div class="avatar-frame">
              <img src="/me_fr.gif" alt="system avatar matrix" class="avatar-element" />
            </div>

            <span class="dossier-index">// biological_profile</span>
            <h1 class="dossier-heading">tom thatcher</h1>
            
            <p class="dossier-lead">
              operating at the convergence of spatial data engineering, embedded electrical architectures, and signal logic systems.
            </p>

            <div class="coordinate-block">
              <div class="coord-row">
                <span class="coord-label">location:</span>
                <span class="coord-value">sydney basin, nsw</span>
              </div>
              <div class="coord-row">
                <span class="coord-label">discipline:</span>
                <span class="coord-value">electrical engineering / gis</span>
              </div>
              <div class="coord-row">
                <span class="coord-label">focus:</span>
                <span class="coord-value">topological arrays, sonic routing</span>
              </div>
            </div>
          </div>
        </section>

        <section class="dossier-right">
          
          <article class="stratum-card">
            <div class="card-meta">stratum_01 // operational_history</div>
            <h2 class="card-title">technical trajectory</h2>
            <p class="card-text">
              my current work processes spatial data layers and geometric infrastructure modeling within the geographic information systems (gis) domain. this professional immersion in mapping informs my approach to hardware architectures, bridging the gap between absolute spatial coordinates and physical computational nodes.
            </p>
            <p class="card-text">
              parallel to this, i am advancing through an electrical engineering focus, investigating network signal constraints, mathematical optimization frameworks, and custom embedded systems logic.
            </p>
          </article>

          <article class="stratum-card">
            <div class="card-meta">stratum_02 // research_assemblages</div>
            <h2 class="card-title">conceptual foundations</h2>
            <p class="card-text">
              the technical systems i build are heavily structured by post-structuralist thought, materialist philosophy, and intense structural schema mapping. i treat signal routing, infinite audio looping, and hardware architectures not merely as utilitarian tools, but as concrete machinic assemblages.
            </p>
            <p class="card-text">
              from analyzing the lines of flight across a metropolitan logistics network to mapping the sonic intensities of raw, multi-layered live signals, my work prioritizes strict spatial layouts, tactile feedback constraints, and structural rigor.
            </p>
          </article>

          <article class="stratum-card">
            <div class="card-meta">stratum_03 // auxiliary_vectors</div>
            <h2 class="card-title">peripheral dynamics</h2>
            <p class="card-text">
              beyond computation, my work relies on direct, physical environmental tracking. this includes bio-acoustic mapping (such as localized environmental listener arrays configured to track regional wildlife audio traces) and high-density volumetric vision captures that translate real-world physical structures back into digital coordinate networks.
            </p>
          </article>

        </section>

      </main>

      <footer class="schema-footer">
        <a href="/" class="return-node">← return to core schema index</a>
        <div class="footer-controls">
          <button id="theme-toggle" class="theme-btn" aria-label="toggle system spectrum">// invert_spectrum</button>
          <span class="system-status">status // view_equilibrium</span>
        </div>
      </footer>

    </div>

    <script>
      const themeToggle = document.getElementById('theme-toggle');
      themeToggle.addEventListener('click', () => {
        const currentTheme = document.documentElement.getAttribute('data-theme');
        const nextTheme = currentTheme === 'light' ? 'dark' : 'light';
        document.documentElement.setAttribute('data-theme', nextTheme);
        localStorage.setItem('schema-theme', nextTheme);
      });
    </script>
  </body>
</html>

<style>
  /* Dual-Spectrum Global Tokens */
  :root[data-theme="dark"] {
    --bg-raw: #050505;
    --bg-canvas: #090909;
    --ink-stark: #ffffff;
    --ink-muted: #666666;
    --ink-ghost: #222222;
    --avatar-bg: #000000;      /* dark theme locks container to pure gif black */
    --avatar-blend: normal;
  }

  :root[data-theme="light"] {
    --bg-raw: #f5f5f5;
    --bg-canvas: #ededed;
    --ink-stark: #050505;
    --ink-muted: #888888;
    --ink-ghost: #dcdcdc;
    --avatar-bg: transparent;  /* light theme clears the box out */
    --avatar-blend: screen;    /* knocks out absolute black pixels against light gray */
  }

  html, body {
    margin: 0;
    padding: 0;
    width: 100%;
    height: 100%;
    background-color: var(--bg-raw);
    color: var(--ink-stark);
    font-family: 'Archivo', 'Helvetica Neue', sans-serif;
    text-transform: lowercase;
    overflow: hidden;
    transition: background-color 0.15s ease, color 0.15s ease;
  }

  .monograph-frame {
    display: flex;
    flex-direction: column;
    width: 100vw;
    height: 100vh;
    box-sizing: border-box;
  }

  .schema-header, .schema-footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 18px 24px;
    font-family: monospace;
    font-size: 0.85rem;
    letter-spacing: -0.01em;
    border-bottom: 4px solid var(--ink-stark);
    background: var(--bg-raw);
    z-index: 10;
    transition: border-color 0.15s ease, background-color 0.15s ease;
  }
  
  .schema-footer {
    border-bottom: none;
    border-top: 4px solid var(--ink-stark);
  }

  .footer-controls {
    display: flex;
    align-items: center;
    gap: 24px;
  }

  .theme-btn {
    background: transparent;
    border: none;
    color: var(--ink-stark);
    font-family: monospace;
    font-size: 0.85rem;
    cursor: pointer;
    padding: 0;
    font-weight: 700;
  }
  .theme-btn:hover {
    color: var(--ink-muted);
  }

  .return-node {
    color: var(--ink-stark);
    text-decoration: none;
    font-weight: 700;
  }
  .return-node:hover {
    text-decoration: underline;
  }

  /* Two-Column Asymmetric Layout */
  .diagram-matrix {
    flex: 1;
    display: grid;
    grid-template-columns: 1fr 1.3fr;
    overflow: hidden;
  }

  @media (max-width: 900px) {
    .diagram-matrix {
      grid-template-columns: 1fr;
      overflow-y: auto;
    }
    .dossier-left {
      border-right: none !important;
      border-bottom: 4px solid var(--ink-stark);
    }
    .sticky-manifesto {
      position: relative !important;
      top: 0 !important;
    }
  }

  /* Left Side Panel: Stationary Static Data Profile */
  .dossier-left {
    border-right: 4px solid var(--ink-stark);
    background: var(--bg-canvas);
    padding: 64px;
    position: relative;
    transition: background-color 0.15s ease, border-color 0.15s ease;
  }

  .sticky-manifesto {
    position: sticky;
    top: 32px;
  }

  /* Avatar Graphic Wrapper */
  .avatar-frame {
    width: 100%;
    max-width: 240px;
    background: var(--avatar-bg); /* controlled dynamically by token set */
    border: 4px solid var(--ink-stark);
    margin-bottom: 32px;
    overflow: hidden;
    display: flex;
    justify-content: center;
    align-items: center;
    transition: background-color 0.15s ease;
  }

   
    .avatar-element {
    width: 100%;
    height: auto;
    display: block;
    mix-blend-mode: var(--avatar-blend);
    image-rendering: pixelated; /* sharpens low-fi sprite vectors */
    
    /* Zoom the asset and nudge it down along the Y-axis to balance the framing */
    transform: scale(1.5) translateY(8px);
    transform-origin: center center;
    }
  .dossier-index {
    font-family: monospace;
    font-size: 0.85rem;
    color: var(--ink-muted);
    display: block;
    margin-bottom: 16px;
  }

  .dossier-heading {
    font-size: 3.2rem;
    font-weight: 900;
    letter-spacing: -0.05em;
    margin: 0 0 24px 0;
  }

  .dossier-lead {
    font-size: 1.3rem;
    line-height: 1.6;
    color: var(--ink-stark);
    margin: 0 0 48px 0;
    max-width: 420px;
  }

  /* Structural Metadata Block */
  .coordinate-block {
    display: flex;
    flex-direction: column;
    gap: 16px;
    border-top: 2px dashed var(--ink-ghost);
    padding-top: 32px;
  }

  .coord-row {
    display: flex;
    gap: 16px;
    font-family: monospace;
    font-size: 0.9rem;
  }

  .coord-label {
    color: var(--ink-muted);
    width: 100px;
    flex-shrink: 0;
  }

  .coord-value {
    color: var(--ink-stark);
    font-weight: 700;
  }

  /* Right Side Panel: Fluid Narrative Strata */
  .dossier-right {
    display: flex;
    flex-direction: column;
    overflow-y: auto;
    padding: 64px;
    gap: 56px;
    background: var(--bg-raw);
  }

  .stratum-card {
    display: flex;
    flex-direction: column;
    border-bottom: 2px solid var(--ink-ghost);
    padding-bottom: 48px;
  }
  .stratum-card:last-child {
    border-bottom: none;
    padding-bottom: 0;
  }

  .card-meta {
    font-family: monospace;
    font-size: 0.85rem;
    color: var(--ink-muted);
    margin-bottom: 16px;
  }

  .card-title {
    font-size: 2rem;
    font-weight: 900;
    letter-spacing: -0.04em;
    margin: 0 0 20px 0;
  }

  .card-text {
    font-size: 1.15rem;
    line-height: 1.7;
    color: var(--ink-muted);
    margin: 0 0 20px 0;
    max-width: 580px;
  }
</style>




