---
// src/pages/index.astro
// Frontmatter clear to avoid compilation friction
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Numogram // Network</title>
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
    
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Archivo:ital,wght@0,800;0,900;1,800;1,900&display=swap" rel="stylesheet">
  </head>
  <body>
    
    <div id="terminal-brand">
      tom_thatcher<span class="terminal-cursor">_</span>
    </div>

    <button id="theme-toggle" aria-label="Toggle System Schema">
      [ SYS_THEME // DARK ]
    </button>

    <main class="terminal-screen">
      <div id="numogram-ui"></div>
    </main>

  </body>
</html>

<script>
  import L from 'leaflet';

  // 1. Initialize Flat Coordinate Space
  const map = L.map('numogram-ui', {
    crs: L.CRS.Simple,
    minZoom: -1,
    maxZoom: 1,
    zoomControl: false,
    attributionControl: false,
    dragging: true,
  });

  const bounds = [[0, 0], [1000, 1000]];
  map.setView([500, 500], 0);
  map.setMaxBounds(bounds);

  // 2. Core Node Positions
  const nodes = {
    blog: [250, 500],
    about: [480, 320],
    music: [520, 680],
    projects: [750, 500]
  };

  // 3. Dense Background Hatching
  const drawDenseHatch = (startY, startX, count, spacing, length, angleFactor = 1) => {
    for (let i = 0; i < count; i++) {
      const offset = i * spacing;
      const path = [
        [startY + offset, startX],
        [startY + offset + (length * angleFactor), startX + length]
      ];
      L.polyline(path, {
        color: '#ffffff', 
        weight: 1.5,
        opacity: 0.55,
        className: 'numogram-hatch'
      }).addTo(map);
    }
  };

  drawDenseHatch(260, 300, 35, 6, 100, 1);   
  drawDenseHatch(420, 500, 30, 6, -100, -1); 
  drawDenseHatch(620, 440, 18, 8, 70, 1);    

  // 4. Heavy Brutalist Tracks (22px Solid Ribbons)
  const conduitLeft = [
    nodes.blog,
    [320, 430], 
    [410, 430], 
    [410, 320], 
    nodes.about,
    [600, 440], 
    [660, 500], 
    nodes.projects
  ];

  const conduitRight = [
    nodes.blog,
    [370, 620], 
    [460, 620], 
    nodes.music, 
    [670, 680], 
    [750, 600], 
    nodes.projects
  ];

  L.polyline(conduitLeft, {
    color: '#ffffff',
    weight: 22, 
    lineJoin: 'miter',
    lineCap: 'square',
    className: 'brutalist-track'
  }).addTo(map);

  L.polyline(conduitRight, {
    color: '#ffffff',
    weight: 22,
    lineJoin: 'miter',
    lineCap: 'square',
    className: 'brutalist-track'
  }).addTo(map);


  // 5. Multi-Directional Nested Double-Chevron Engine (Synchronized Segment Flow with Corner Clipping)
  const arrowPool = [];
  const arrowSpacing = 240; 
  const edgePadding = 25; // Dead-zone buffer to keep chevrons completely clear of vertices

  const conduitsConfig = [
    { path: conduitLeft, dir: 1 },
    { path: conduitRight, dir: -1 }
  ];

  conduitsConfig.forEach(config => {
    const path = config.path;
    const segmentsData = [];
    
    // First pass: Build individual geometric profile definitions
    for (let i = 0; i < path.length - 1; i++) {
      const p1 = path[i];
      const p2 = path[i + 1];
      const dy = p2[0] - p1[0];
      const dx = p2[1] - p1[1];
      const len = Math.sqrt(dx * dx + dy * dy);
      const angle = Math.atan2(dy, dx);
      
      segmentsData.push({
        p1, dy, dx, len, angle,
        dir: config.dir,
        startDist: 0
      });
    }

    // Second pass: Compute rolling chainage offsets based matching their flow orientation
    let currentAccum = 0;
    if (config.dir === 1) {
      for (let i = 0; i < segmentsData.length; i++) {
        segmentsData[i].startDist = currentAccum;
        currentAccum += segmentsData[i].len;
      }
    } else {
      for (let i = segmentsData.length - 1; i >= 0; i--) {
        segmentsData[i].startDist = currentAccum;
        currentAccum += segmentsData[i].len;
      }
    }

    // Third pass: Allocate localized render containers per segment block
    segmentsData.forEach(seg => {
      const effectiveAngle = seg.dir === 1 ? seg.angle : seg.angle + Math.PI;
      const maxArrows = Math.ceil(seg.len / arrowSpacing) + 1;
      
      for (let j = 0; j < maxArrows; j++) {
        const poly = L.polyline([], {
          color: '#000000',
          weight: 2,        
          lineCap: 'square',
          lineJoin: 'miter',
          className: 'kinetic-arrow-segment'
        }).addTo(map);
        
        arrowPool.push({
          poly,
          p1: seg.p1,
          dy: seg.dy,
          dx: seg.dx,
          len: seg.len,
          angle: effectiveAngle,
          dir: seg.dir,
          startDist: seg.startDist,
          j: j
        });
      }
    });
  });

  let currentScroll = 0;
  function animateFlow() {
    currentScroll += 0.55; 
    
    arrowPool.forEach(item => {
      // Unify the loop wave via a standardized spacing rhythm
      let baseD = (currentScroll - item.startDist) % arrowSpacing;
      if (baseD < 0) baseD += arrowSpacing;
      
      // Map the current slot distance down the segment layout
      let d = baseD + item.j * arrowSpacing;
      
      // Strict layout constraint: Arrow must be within the straight bounds AND clear of the edge padding
      if (d >= edgePadding && d <= item.len - edgePadding) {
        // Handle coordinate translation vector based on flow direction profiles
        const localD = item.dir === 1 ? d : item.len - d;
        
        const y = item.p1[0] + (item.dy * localD / item.len);
        const x = item.p1[1] + (item.dx * localD / item.len);
        
        const alpha = 0.75; 
        const wingLen = 15; 
        
        // Front Chevron
        const w1_y = y - wingLen * Math.sin(item.angle + alpha);
        const w1_x = x - wingLen * Math.cos(item.angle + alpha);
        const w2_y = y - wingLen * Math.sin(item.angle - alpha);
        const w2_x = x - wingLen * Math.cos(item.angle - alpha);
        
        // Rear Nested Chevron
        const d_rear = 2; 
        const y_r = y - d_rear * Math.sin(item.angle);
        const x_r = x - d_rear * Math.cos(item.angle);
        
        const w1_y_r = y_r - wingLen * Math.sin(item.angle + alpha);
        const w1_x_r = x_r - wingLen * Math.cos(item.angle + alpha);
        const w2_y_r = y_r - wingLen * Math.sin(item.angle - alpha);
        const w2_x_r = x_r - wingLen * Math.cos(item.angle - alpha);
        
        item.poly.setLatLngs([
          [[w1_y, w1_x], [y, x], [w2_y, w2_x]],
          [[w1_y_r, w1_x_r], [y_r, x_r], [w2_y_r, w2_x_r]]
        ]);
      } else {
        item.poly.setLatLngs([]); // Pristine wipeout inside junction dead-zones
      }
    });
    
    requestAnimationFrame(animateFlow);
  }
  animateFlow();


  // 6. Architectural Gate Breaks
  const injectGate = (coords, gateNumber) => {
    const gateIcon = L.divIcon({
      className: 'gate-marker-wrapper',
      html: `<div class="gate-plate">${gateNumber}</div>`,
      iconSize: [44, 26],
      iconAnchor: [22, 13]
    });
    L.marker(coords, { icon: gateIcon }).addTo(map);
  };


  // 7. Solid Esoteric Stamped Circles
  const numogramDigits = { blog: '3', projects: '1', music: '2', about: '0' };

  Object.entries(nodes).forEach(([key, coords]) => {
    const parsedLabel = key.charAt(0).toLowerCase() + key.slice(1);

    const customIcon = L.divIcon({
      className: 'numogram-marker-container',
      html: `
        <div class="numogram-brutalist-node">
          <div class="solid-node-circle">
            <span class="inner-digit">${numogramDigits[key]}</span>
          </div>
          <div class="floating-label">
            <a href="/${key}" class="raw-anchor">${parsedLabel}</a>
          </div>
        </div>
      `,
      iconSize: null, 
      iconAnchor: [35, 35] 
    });

    L.marker(coords, { icon: customIcon }).addTo(map);
  });


  // =====================================================================
  // 8. PROCEDURAL METRO BACKGROUND GENERATOR (Tron Grid / Self-Avoiding)
  // =====================================================================
  if (!map.getPane('metroBackground')) {
    const bgPane = map.createPane('metroBackground');
    bgPane.style.zIndex = 220; // Sandwiched perfectly below the foreground elements
    bgPane.style.pointerEvents = 'none';
  }

  const METRO_COLORS = ['#E31837', '#0038A8', '#009B3A', '#FFD100', '#00A3E0', '#702082', '#FF6200'];
  const activeLines = [];
  const maxConcurrentLines = 4; // Keeps generation focused and highly legible
  const segmentLengthPixels = 45; // Match alignment step with line weight profiles
  const gridResolution = 45;     // Massive geometric spacing to stop overlap dead

  // Spatial Tracking Ledger: Global coordinate locks
  const occupiedGrid = new Set();

  // Pre-seed the ledger with your primary core conduit nodes so background lines dodge them
  const seedForbiddenZones = () => {
    // Blocks out area keys surrounding the main tracks
    const pathsToBlock = [...conduitLeft, ...conduitRight];
    pathsToBlock.forEach(pt => {
      for (let yOffset = -45; yOffset <= 45; yOffset += 45) {
        for (let xOffset = -45; xOffset <= 45; xOffset += 45) {
          occupiedGrid.add(hashGridKey(pt[0] + yOffset, pt[1] + xOffset));
        }
      }
    });
  };

  function hashGridKey(lat, lng) {
    const gLat = Math.round(lat / gridResolution) * gridResolution;
    const gLng = Math.round(lng / gridResolution) * gridResolution;
    return `${gLat},${gLng}`;
  }

  function getOctolinearVector(angleIndex) {
    const angles = [0, 45, 90, 135, 180, 225, 270, 315];
    const rad = (angles[angleIndex] * Math.PI) / 180;
    return {
      dY: segmentLengthPixels * Math.sin(rad),
      dX: segmentLengthPixels * Math.cos(rad)
    };
  }

  seedForbiddenZones();

  function spawnMetroLine() {
    if (activeLines.length >= maxConcurrentLines) return;

    // 1. Core Optimization: Sample directly from the hard boundary frame limits 
    // instead of dynamic viewport windows to guarantee even distribution.
    const minCoord = 50;   // Inset slightly so they don't spawn right on the raw edge
    const maxCoord = 950;  
    
    let startLat = minCoord + Math.random() * (maxCoord - minCoord);
    let startLng = minCoord + Math.random() * (maxCoord - minCoord);
    
    // 2. Snap to the massive grid spacing
    startLat = Math.round(startLat / gridResolution) * gridResolution;
    startLng = Math.round(startLng / gridResolution) * gridResolution;
    
    const startPoint = L.latLng(startLat, startLng);
    const key = hashGridKey(startLat, startLng);

    // If an old track path already claims this grid tile, skip it
    if (occupiedGrid.has(key)) return;

    const color = METRO_COLORS[Math.floor(Math.random() * METRO_COLORS.length)];
    
    // 3. True Randomized Vector Trajectory: Mixes up all 8 cardinal/intercardinal paths
    const initialAngleIndex = Math.floor(Math.random() * 8);

    const polyline = L.polyline([startPoint], {
      color: color,
      weight: 22, 
      className: 'metro-bg-line',
      lineCap: 'square',
      lineJoin: 'miter',
      pane: 'metroBackground'
    }).addTo(map);

    activeLines.push({
      layer: polyline,
      coords: [startPoint],
      currentAngleIndex: initialAngleIndex,
      stuckCounter: 0
    });

    occupiedGrid.add(key);
  }

  function growMetroLines() {
    for (let i = activeLines.length - 1; i >= 0; i--) {
      const line = activeLines[i];
      const lastPt = line.coords[line.coords.length - 1];
      
      let targetAngleIndex = line.currentAngleIndex;
      let nextPt = null;
      let foundClearPath = false;

      // Scan choices: 1. Keep straight, 2. Minor turn (45°), 3. Hard turn (90°)
      const directionalChoices = [0, 1, -1, 2, -2];
      
      for (let choice of directionalChoices) {
        const checkIndex = (line.currentAngleIndex + choice + 8) % 8;
        const vector = getOctolinearVector(checkIndex);
        const testPt = L.latLng(lastPt.lat + vector.dY, lastPt.lng + vector.dX);
        const testKey = hashGridKey(testPt.lat, testPt.lng);

        // Make sure point is clear and safely inside the outer frame boundary
        if (!occupiedGrid.has(testKey) && map.getBounds().pad(-0.02).contains(testPt)) {
          targetAngleIndex = checkIndex;
          nextPt = testPt;
          foundClearPath = true;
          break;
        }
      }

      if (foundClearPath && nextPt) {
        line.coords.push(nextPt);
        line.layer.setLatLngs(line.coords); // Native update without deletion
        line.currentAngleIndex = targetAngleIndex;
        occupiedGrid.add(hashGridKey(nextPt.lat, nextPt.lng));
        line.stuckCounter = 0;
      } else {
        line.stuckCounter++;
        if (line.stuckCounter > 1) {
          // Permanently frozen in place like an old light cycle trail. Split and spawn elsewhere.
          activeLines.splice(i, 1);
        }
      }
    }
  }

  // Balanced loop times for structured layout builds
  setInterval(spawnMetroLine, 800); 
  setInterval(growMetroLines, 220);

  // 9. Light/Dark Mode DOM Switch Logic
  const toggleBtn = document.getElementById('theme-toggle');
  toggleBtn.addEventListener('click', () => {
    const isLight = document.body.classList.toggle('light-schema');
    toggleBtn.innerText = isLight ? '[ SYS_THEME // LIGHT ]' : '[ SYS_THEME // DARK ]';
  });
</script>

<style>
  /* System Typography & Theme Variable Mapping */
  :root {
    --bg-raw: #050505;
    --track-fill: #ffffff;
    --arrow-fill: #000000;
    --hatch-fill: #ffffff;
    
    --node-bg: #e2e2e2;
    --node-border: #ffffff;
    --node-text: #050505;
    --label-bg: #050505;
    --label-text: #ffffff;
    
    --gate-bg: #050505;
    --gate-border: #ffffff;
    --gate-text: #ffffff;
    
    --metro-opacity: 0.45;
    --font-wipeout: 'Archivo', 'Helvetica Neue', sans-serif;
  }

  /* Inverted Archetype Variables (System Blueprint Light Mode) */
  body.light-schema {
    --bg-raw: #f2f2f2;
    --track-fill: #050505;
    --arrow-fill: #ffffff; 
    --hatch-fill: #000000;
    
    --node-bg: #151515;
    --node-border: #050505;
    --node-text: #f2f2f2;
    --label-bg: #f2f2f2;
    --label-text: #050505;
    
    --gate-bg: #f2f2f2;
    --gate-border: #050505;
    --gate-text: #050505;
    
    --metro-opacity: 0.28;
  }

  html, body {
    margin: 0;
    padding: 0;
    width: 100%;
    height: 100%;
    overflow: hidden;
    font-family: var(--font-wipeout);
    background-color: var(--bg-raw);
    transition: background-color 0.25s ease;
  }

  /* Fixed Terminal Brand Header */
  #terminal-brand {
    position: fixed;
    top: 24px;
    left: 24px;
    z-index: 9999;
    color: var(--label-text);
    font-family: monospace;
    font-size: 2.15rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    text-transform: lowercase;
    pointer-events: none; 
    transition: color 0.25s ease;
  }

  /* Rigid Step Blinking Terminal Cursor */
  .terminal-cursor {
    font-weight: 900;
    animation: terminalBlink 1s steps(2, start) infinite;
  }

  @keyframes terminalBlink {
    to {
      visibility: hidden;
    }
  }

  /* Utility Diagnostic Toggle Button Styling */
  #theme-toggle {
    position: fixed;
    top: 20px;
    right: 20px;
    z-index: 9999;
    background: var(--bg-raw);
    color: var(--label-text);
    border: 2px solid var(--label-text);
    padding: 6px 12px;
    font-family: monospace; 
    font-weight: 900;
    cursor: pointer;
    letter-spacing: 0.05em;
    transition: all 0.15s ease;
  }
  #theme-toggle:hover {
    background: var(--label-text);
    color: var(--bg-raw);
  }

  .terminal-screen {
    width: 100vw;
    height: 100vh;
    background: transparent;
    position: relative;
  }

  #numogram-ui {
    width: 100%;
    height: 100%;
    background: transparent;
  }

  /* Vector Direct Overrides via Injected Classes */
  :global(.brutalist-track) {
    stroke: var(--track-fill) !important;
    opacity: 1;
    transition: stroke 0.25s ease;
  }

  :global(.kinetic-arrow-segment) {
    stroke: var(--arrow-fill) !important;
    z-index: 350 !important;
    pointer-events: none;
    transition: stroke 0.25s ease;
  }

  /* Procedural Metro Map Class Binding */
  :global(.metro-bg-line) {
    opacity: var(--metro-opacity) !important;
    transition: opacity 0.25s ease;
  }

  /* Crawling Background Hatch Grid */
  :global(.numogram-hatch) {
    stroke: var(--hatch-fill) !important;
    stroke-linecap: square;
    stroke-dasharray: 60, 40;
    animation: hatchVibrate 20s linear infinite;
    transition: stroke 0.25s ease;
  }

  @keyframes hatchVibrate {
    to {
      stroke-dashoffset: 160;
    }
  }

  /* Sharp Clean Gate Blocks cutting line continuity */
  :global(.gate-marker-wrapper) {
    background: transparent !important;
    border: none !important;
    z-index: 400 !important;
  }
  :global(.gate-plate) {
    background-color: var(--gate-bg);
    color: var(--gate-text);
    border: 3px solid var(--gate-border);
    font-family: var(--font-wipeout);
    font-size: 0.85rem;
    font-weight: 200;
    text-align: center;
    line-height: 20px;
    height: 20px;
    width: 38px;
    letter-spacing: -0.05em;
    transition: background-color 0.25s ease, color 0.25s ease, border-color 0.25s ease;
  }

  /* Node Placements */
  :global(.numogram-marker-container) {
    background: transparent !important;
    border: none !important;
    z-index: 500 !important;
    width: auto !important;
    height: auto !important;
  }

  .numogram-brutalist-node {
    display: flex;
    align-items: center;
    position: relative;
    width: max-content; 
  }

  /* Flat Ink Block Circles */
  :global(.solid-node-circle) {
    width: 70px;
    height: 70px;
    background-color: var(--node-bg);
    border: 5px solid var(--node-border);
    border-radius: 50%;
    display: flex;
    justify-content: center;
    align-items: center;
    box-shadow: none;
    flex-shrink: 0; 
    transition: transform 0.12s cubic-bezier(0.215, 0.610, 0.355, 1), background-color 0.25s ease, border-color 0.25s ease;
  }

  :global(.inner-digit) {
    color: var(--node-text);
    font-family: var(--font-wipeout);
    font-size: 2.1rem;
    font-weight: 200;
    letter-spacing: -0.05em;
    transition: color 0.25s ease;
  }

  /* Typography Structure */
  :global(.floating-label) {
    margin-left: 22px;
    background: var(--label-bg);
    padding: 4px 10px;
    border: 1px solid transparent;
    width: max-content; 
    white-space: nowrap; 
    transition: background-color 0.25s ease;
  }

  :global(.raw-anchor) {
    color: var(--label-text);
    font-family: var(--font-wipeout);
    text-decoration: none;
    font-size: 1.25rem;
    font-weight: 900; 
    letter-spacing: 0.05em; 
    transition: color 0.25s ease;
  }

  /* Interaction Profiles */
  :global(.numogram-brutalist-node:hover .solid-node-circle) {
    transform: scale(1.06);
    background-color: var(--node-border);
  }

  body:not(.light-schema) :global(.numogram-brutalist-node:hover .raw-anchor) {
    color: #bcbcbc;
    text-decoration: underline;
    text-underline-offset: 5px;
  }

  body.light-schema :global(.numogram-brutalist-node:hover .raw-anchor) {
    color: #555555;
    text-decoration: underline;
    text-underline-offset: 5px;
  }
</style>