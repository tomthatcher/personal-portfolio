                    <circle cx="200" cy="370" r="4" fill="var(--ink-stark)" stroke="var(--accent-orange)" stroke-width="1.5"/>
                    <circle cx="290" cy="290" r="4" fill="var(--ink-stark)" stroke="var(--accent-orange)" stroke-width="1.5"/>
                    <circle cx="330" cy="200" r="4" fill="var(--ink-stark)" stroke="var(--accent-orange)" stroke-width="1.5"/>

                    <g fill="var(--accent-orange)" font-family="monospace" font-size="8" opacity="0.8">
                        <text x="212" y="34">idx // 00.000_start</text>
                        <text x="35" y="105">node // hotkey.01</text>
                        <text x="15" y="215">node // hotkey.02</text>
                        <text x="245" y="375">ptr // wrap_boundary</text>
                    </g>
