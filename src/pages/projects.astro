---
// src/pages/projects.astro
const baseUrl = import.meta.env.BASE_URL;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>numogram // schema</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Archivo:ital,wght=0,500;0,700;0,900;1,900&display=swap" rel="stylesheet">
    <script is:inline>
      const savedTheme = localStorage.getItem('schema-theme') || 'dark';
      document.documentElement.setAttribute('data-theme', savedTheme);
    </script>
  </head>
  <body>

    <div class="monograph-frame">
      
      <header class="schema-header">
        <div class="meta-left">t.thatcher // rhizomatic matrix</div>
        <div class="meta-right">plate_2.03 // vitruvian_strata</div>
      </header>

      <main class="diagram-matrix">
        
        <section class="graphic-quadrant">
          <div class="abstract-canvas">
            
            <svg class="diagram-svg" viewBox="0 0 500 500" preserveAspectRatio="xMidYMid meet">
              <g class="vitruvian-background">
                <rect x="75" y="75" width="350" height="350" fill="none" class="vitruvian-geo" />
                <circle cx="250" cy="250" r="195" fill="none" class="vitruvian-geo" />
                
                <line x1="75" y1="75" x2="425" y2="425" class="vitruvian-geo" />
                <line x1="425" y1="75" x2="75" y2="425" class="vitruvian-geo" />

                <circle cx="250" cy="120" r="14" fill="none" class="vitruvian-body" />
                <line x1="250" y1="134" x2="250" y2="310" class="vitruvian-body" />
                
                <line x1="250" y1="165" x2="90" y2="165" class="vitruvian-body" /> <line x1="250" y1="165" x2="410" y2="165" class="vitruvian-body" /> <line x1="250" y1="310" x2="210" y2="425" class="vitruvian-body" /> <line x1="250" y1="310" x2="290" y2="425" class="vitruvian-body" /> <line x1="250" y1="165" x2="95" y2="105" class="vitruvian-body" stroke-dasharray="4 4" /> <line x1="250" y1="165" x2="405" y2="105" class="vitruvian-body" stroke-dasharray="4 4" /> <line x1="250" y1="310" x2="155" y2="400" class="vitruvian-body" stroke-dasharray="4 4" /> <line x1="250" y1="310" x2="345" y2="400" class="vitruvian-body" stroke-dasharray="4 4" /> </g>

              <line class="svg-axis" x1="0" y1="250" x2="500" y2="250" />
              <line class="svg-axis" x1="250" y1="0" x2="250" y2="500" />
              
              <circle class="svg-ring real-stratum" cx="250" cy="180" r="110" />
              <circle class="svg-ring symbolic-stratum" cx="170" cy="300" r="100" />
              <circle class="svg-ring imaginary-stratum" cx="330" cy="300" r="100" />

              <line class="node-connector" x1="250" y1="180" x2="150" y2="220" id="line-sydney" />
              <line class="node-connector" x1="250" y1="180" x2="350" y2="200" id="line-looper" />
              <line class="node-connector" x1="170" y1="300" x2="190" y2="380" id="line-magpie" />
              <line class="node-connector" x1="330" y1="300" x2="310" y2="390" id="line-vision" />
              <line class="node-connector latent" x1="250" y1="180" x2="250" y2="90" id="line-custom" />

              <g class="interactive-node" id="node-sydney" tabindex="0">
                <circle class="node-point core" cx="150" cy="220" r="12" />
                <text class="node-label" x="55" y="200">α // syd_routing</text>
              </g>

              <g class="interactive-node" id="node-looper" tabindex="0">
                <circle class="node-point core" cx="350" cy="200" r="12" />
                <text class="node-label" x="375" y="195">γ // infinite_loop</text>
              </g>

              <g class="interactive-node" id="node-magpie" tabindex="0">
                <circle class="node-point core" cx="190" cy="380" r="12" />
                <text class="node-label" x="80" y="405">δ // audio_census</text>
              </g>

              <g class="interactive-node" id="node-vision" tabindex="0">
                <circle class="node-point core" cx="310" cy="390" r="12" />
                <text class="node-label" x="335" y="415">ε // spatial_vision</text>
              </g>

              <g class="interactive-node" id="node-custom" tabindex="0">
                <circle class="node-point latent" cx="250" cy="90" r="12" />
                <text class="node-label latent" x="190" y="65">β // virtual_stratum</text>
              </g>
            </svg>

            <div class="diagram-tag tag-rsi">[ r ∩ s ∩ i ]</div>
            <div class="diagram-tag tag-intensity">density // 0.94</div>
          </div>
        </section>

        <section class="textual-quadrant" id="info-panel">
          
          <div class="info-stratum" id="stratum-default">
            <h2 class="stratum-title">select a node</h2>
            <p class="stratum-abstract">
              interact directly with the vector graph trajectories to map interconnected projects, physical computing archives, and spatial routing schemas.
            </p>
          </div>

          <div class="info-stratum hidden" id="stratum-sydney">
            <div class="stratum-index">stratum_01 // metropolitan_routing</div>
            <h2 class="stratum-title">sydney spatial routing</h2>
            <p class="stratum-abstract">
              algorithmic cartography tracking network geometries, infrastructure constraints, and topological data flows across the sydney basin mesh.
            </p>
            <div class="stratum-action">
              <a href={`${baseUrl}sydney-routing`} class="action-trigger">execute trajectory ↗</a>
            </div>
          </div>

          <div class="info-stratum hidden" id="stratum-looper">
            <div class="stratum-index">stratum_02 // sonic_assemblage</div>
            <h2 class="stratum-title">infinite loop architecture</h2>
            <p class="stratum-abstract">
              a custom digital hardware looper repurposed from a stripped laptop ecosystem. engineered to process complex sonic layers and maintain permanent, infinite signal loops without memory degradation.
            </p>
            <div class="stratum-action">
              <a href={`${baseUrl}looper`} class="action-trigger">execute trajectory ↗</a>
            </div>
          </div>

          <div class="info-stratum hidden" id="stratum-magpie">
            <div class="stratum-index">stratum_03 // bio_acoustic_vector</div>
            <h2 class="stratum-title">magpie audio census</h2>
            <p class="stratum-abstract">
              an embedded environmental listener parsing ecological data streams. uses a localized raspberry pi microphone array configured to isolate, decode, and track regional magpie calls.
            </p>
            <div class="stratum-action">
              <a href={`${baseUrl}biomap`} class="action-trigger">execute trajectory ↗</a>
            </div>
          </div>

          <div class="info-stratum hidden" id="stratum-vision">
            <div class="stratum-index">stratum_04 // neural_volumetrics</div>
            <h2 class="stratum-title">volumetric vision fields</h2>
            <p class="stratum-abstract">
              experiments in advanced point-cloud interpolation and computer vision frameworks, converting raw video coordinates into interactive, high-density 3d gaussian splats.
            </p>
            <div class="stratum-action">
              <span class="action-static">// render_mesh_active</span>
            </div>
          </div>

          <div class="info-stratum hidden" id="stratum-custom">
            <div class="stratum-index">stratum_05 // virtual_plane</div>
            <h2 class="stratum-title">custom spatial tech</h2>
            <p class="stratum-abstract">
              archives detailing integrated spatial frameworks, geo-computational models, and embedded network topologies currently maintained in a latent state.
            </p>
            <div class="stratum-action">
              <a href={`${baseUrl}image-point-engine`} class="action-trigger">execute trajectory ↗</a>
            </div>
          </div>

        </section>

      </main>

      <footer class="schema-footer">
        <a href={baseUrl} class="return-node">← return to core schema index</a>
        <div class="footer-controls">
          <button id="theme-toggle" class="theme-btn" aria-label="toggle system spectrum">// invert_spectrum</button>
          <span class="system-status" id="panel-status">status // awaiting_selection</span>
        </div>
      </footer>

    </div>

    <script>
      const nodeKeys = ['sydney', 'looper', 'magpie', 'vision', 'custom'];
      const nodes = {};
      const lines = {};
      const panels = { default: document.getElementById('stratum-default') };
      
      nodeKeys.forEach(key => {
        nodes[key] = document.getElementById(`node-${key}`);
        lines[key] = document.getElementById(`line-${key}`);
        panels[key] = document.getElementById(`stratum-${key}`);
      });

      const statusText = document.getElementById('panel-status');

      function activateNode(selectedKey) {
        Object.keys(panels).forEach(key => panels[key].classList.add('hidden'));
        nodeKeys.forEach(key => {
          nodes[key].classList.remove('active');
          lines[key].classList.remove('active');
        });

        if (selectedKey) {
          panels[selectedKey].classList.remove('hidden');
          nodes[selectedKey].classList.add('active');
          lines[selectedKey].classList.add('active');
          statusText.innerText = `status // node_${selectedKey}_engaged`;
        } else {
          panels.default.classList.remove('hidden');
          statusText.innerText = 'status // awaiting_selection';
        }
      }

      nodeKeys.forEach(key => {
        nodes[key].addEventListener('click', () => activateNode(key));
        nodes[key].addEventListener('keydown', (e) => {
          if (e.key === 'Enter' || e.key === ' ') {
            e.preventDefault();
            activateNode(key);
          }
        });
      });

      const themeToggle = document.getElementById('theme-toggle');
      themeToggle.addEventListener('click', () => {
        const currentTheme = document.documentElement.getAttribute('data-theme');
        const nextTheme = currentTheme === 'light' ? 'dark' : 'light';
        document.documentElement.setAttribute('data-theme', nextTheme);
        localStorage.setItem('schema-theme', nextTheme);
      });
    </script>
  </body>
</html>

<style>
  /* Dual-Spectrum Global Tokens */
  :root[data-theme="dark"] {
    --bg-raw: #050505;
    --bg-canvas: #090909;
    --ink-stark: #ffffff;
    --ink-muted: #666666;
    --ink-ghost: #222222;
    --ink-vitruvian: #141414;
    --accent-signal: #e31837;
  }

  :root[data-theme="light"] {
    --bg-raw: #f5f5f5;
    --bg-canvas: #ededed;
    --ink-stark: #050505;
    --ink-muted: #888888;
    --ink-ghost: #dcdcdc;
    --ink-vitruvian: #cccccc;
    --accent-signal: #e31837;
  }

  html, body {
    margin: 0;
    padding: 0;
    width: 100%;
    height: 100%;
    background-color: var(--bg-raw);
    color: var(--ink-stark);
    font-family: 'Archivo', 'Helvetica Neue', sans-serif;
    text-transform: lowercase;
    overflow: hidden;
    transition: background-color 0.15s ease, color 0.15s ease;
  }

  .monograph-frame {
    display: flex;
    flex-direction: column;
    width: 100vw;
    height: 100vh;
    box-sizing: border-box;
  }

  .schema-header, .schema-footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 18px 24px;
    font-family: monospace;
    font-size: 0.85rem;
    letter-spacing: -0.01em;
    border-bottom: 4px solid var(--ink-stark);
    background: var(--bg-raw);
    z-index: 10;
    transition: border-color 0.15s ease, background-color 0.15s ease;
  }
  
  .schema-footer {
    border-bottom: none;
    border-top: 4px solid var(--ink-stark);
  }

  .footer-controls {
    display: flex;
    align-items: center;
    gap: 24px;
  }

  .theme-btn {
    background: transparent;
    border: none;
    color: var(--ink-stark);
    font-family: monospace;
    font-size: 0.85rem;
    cursor: pointer;
    padding: 0;
    text-transform: lowercase;
    font-weight: 700;
  }
  .theme-btn:hover {
    color: var(--ink-muted);
  }

  .return-node {
    color: var(--ink-stark);
    text-decoration: none;
    font-weight: 700;
  }
  .return-node:hover {
    text-decoration: underline;
  }

  .diagram-matrix {
    flex: 1;
    display: grid;
    grid-template-columns: 1.3fr 1fr;
    overflow: hidden;
  }

  @media (max-width: 900px) {
    .diagram-matrix {
      grid-template-columns: 1fr;
      grid-template-rows: 1.2fr 1fr;
    }
    .graphic-quadrant {
      border-right: none !important;
      border-bottom: 4px solid var(--ink-stark);
    }
  }

  .graphic-quadrant {
    border-right: 4px solid var(--ink-stark);
    position: relative;
    background: var(--bg-canvas);
    display: flex;
    justify-content: center;
    align-items: center;
    overflow: hidden;
    transition: background-color 0.15s ease, border-color 0.15s ease;
  }

  .abstract-canvas {
    width: 90%;
    height: 90%;
    position: relative;
    display: flex;
    justify-content: center;
    align-items: center;
  }

  .diagram-svg {
    width: 100%;
    height: 100%;
    z-index: 2;
  }

  .vitruvian-background {
    pointer-events: none;
    opacity: 0.65;
  }
  .vitruvian-geo {
    stroke: var(--ink-ghost);
    stroke-width: 2;
  }
  .vitruvian-body {
    stroke: var(--ink-vitruvian);
    stroke-width: 3;
    stroke-linecap: round;
    stroke-linejoin: round;
    transition: stroke 0.15s ease;
  }

  .svg-axis {
    stroke: var(--ink-ghost);
    stroke-width: 3;
  }

  .svg-ring {
    fill: none;
    stroke: var(--ink-ghost);
    stroke-width: 4;
  }

  .interactive-node {
    cursor: pointer;
    outline: none;
  }

  .node-connector {
    stroke: var(--ink-ghost);
    stroke-width: 5;
    stroke-dasharray: 6 6;
    transition: stroke 0.2s ease, stroke-width 0.2s ease;
  }

  .node-point {
    fill: var(--bg-raw);
    stroke: var(--ink-muted);
    stroke-width: 4;
    transition: all 0.2s ease;
  }

  .node-label {
    fill: var(--ink-muted);
    font-size: 0.8rem;
    font-family: monospace;
    letter-spacing: -0.03em;
    font-weight: 700;
    transition: fill 0.2s ease;
  }

  .interactive-node:hover .node-point.core,
  .interactive-node.active .node-point.core {
    stroke: var(--ink-stark);
    fill: var(--ink-stark);
    r: 15;
  }

  .interactive-node:hover .node-point.latent,
  .interactive-node.active .node-point.latent {
    stroke: var(--accent-signal);
    fill: var(--accent-signal);
    r: 15;
  }

  #node-sydney:hover ~ #line-sydney, #node-sydney.active ~ #line-sydney { stroke: var(--ink-stark); stroke-width: 6; stroke-dasharray: none; }
  #node-looper:hover ~ #line-looper, #node-looper.active ~ #line-looper { stroke: var(--ink-stark); stroke-width: 6; stroke-dasharray: none; }
  #node-magpie:hover ~ #line-magpie, #node-magpie.active ~ #line-magpie { stroke: var(--ink-stark); stroke-width: 6; stroke-dasharray: none; }
  #node-vision:hover ~ #line-vision, #node-vision.active ~ #line-vision { stroke: var(--ink-stark); stroke-width: 6; stroke-dasharray: none; }
  #node-custom:hover ~ #line-custom, #node-custom.active ~ #line-custom { stroke: var(--accent-signal); stroke-width: 6; stroke-dasharray: none; }

  .interactive-node:hover .node-label,
  .interactive-node.active .node-label {
    fill: var(--ink-stark);
  }

  .diagram-tag {
    position: absolute;
    font-family: monospace;
    font-size: 0.75rem;
    background: var(--bg-raw);
    padding: 2px 6px;
    border: 2px solid var(--ink-ghost);
    color: var(--ink-muted);
  }
  .tag-rsi { top: 0; left: 0; }
  .tag-intensity { bottom: 0; right: 0; }

  .textual-quadrant {
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 64px;
    background: var(--bg-raw);
    border-left: 2px solid var(--ink-ghost);
    transition: background-color 0.15s ease, border-color 0.15s ease;
  }

  .info-stratum {
    animation: stepsFade 0.2s steps(3, end);
  }
  .info-stratum.hidden {
    display: none;
  }

  @keyframes stepsFade {
    from { opacity: 0; }
    to { opacity: 1; }
  }

  .stratum-index {
    font-family: monospace;
    font-size: 0.85rem;
    color: var(--ink-muted);
    margin-bottom: 24px;
  }

  .stratum-title {
    font-size: 2.6rem;
    font-weight: 900;
    letter-spacing: -0.05em;
    margin: 0 0 24px 0;
  }

  .stratum-abstract {
    font-size: 1.15rem;
    line-height: 1.65;
    color: var(--ink-muted);
    margin: 0 0 48px 0;
    max-width: 480px;
  }

  .action-trigger {
    display: inline-block;
    font-family: monospace;
    font-weight: 700;
    color: var(--ink-stark);
    text-decoration: none;
    border: 4px solid var(--ink-stark);
    padding: 12px 24px;
    transition: all 0.15s ease;
  }
  .action-trigger:hover {
    background-color: var(--ink-stark);
    color: var(--bg-raw);
  }

  .action-static {
    font-family: monospace;
    color: var(--ink-stark);
    font-size: 0.95rem;
    border: 2px solid var(--ink-muted);
    padding: 10px 20px;
  }
</style>